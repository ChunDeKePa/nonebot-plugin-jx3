# ==============================================================================
# NoneBot2 & 剑网三助手 (.env) 配置文件
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NoneBot 核心基础配置
# ------------------------------------------------------------------------------
# 运行环境模式：dev（开发模式，输出详细日志）或 prod（生产模式）
ENVIRONMENT=prod

# 监听主机与端口（Docker 容器内请保持 0.0.0.0 与 8080）
HOST=0.0.0.0
PORT=8080

# 控制台日志等级：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 机器人超级管理员 QQ 号列表（支持填入多个，以英文逗号分隔）
# 超级管理员拥有最高权限，无视群管理限制，可在任何群直接使用「绑定 <区服>」「订阅 <事件>」「取消订阅」
# 示例：SUPERUSERS=["10001"] 或 SUPERUSERS=["12345678", "87654321"]
SUPERUSERS=["10001"]

# 命令触发前缀
# 包含空字符串 "" 表示直接发送指令即可触发（如直接发 "日常"、"帮助"、"公告"）
# 同时支持带斜杠触发（如 "/日常"）
COMMAND_START=["", "/"]

# 图片渲染引擎配置（已在 Docker 镜像内预装固化 Chromium，请勿随意更改）
RENDER_BACKEND=playwright
RENDER_STORAGE_PATH=/root/.cache/ms-playwright
PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright


# ------------------------------------------------------------------------------
# 2. 群控制与安全策略（白名单设置）
# ------------------------------------------------------------------------------
# 允许响应的 QQ 群白名单（仅群聊有效，私聊不限制）
# - 留空 [] 表示：机器人加入的【所有群】均可使用指令。
# - 填入群号列表表示：【仅允许列表中的群】使用指令，未在列表中的群发送指令将完全静默不予回复，防止被拉入陌生群滥用 API 额度。
# 示例：JX3_ENABLED_GROUPS=[123456789, 987654321]
JX3_ENABLED_GROUPS=[]


# ------------------------------------------------------------------------------
# 3. 游戏区服与个性化配置
# ------------------------------------------------------------------------------
# 默认服务器名称
# 当某个群尚未通过「绑定 <区服>」绑定专属服务器，且玩家输入「日常」「金价」「开服」等指令未附带服务器名时，自动查询此默认区服。
# 示例：绝代天骄、梦江南、长安城、唯我独尊、斗转星移 等
JX3_DEFAULT_SERVER=绝代天骄

# 机器人昵称（会显示在生成的帮助长图、各类查询图片底部及欢迎语中）
JX3_BOT_NAME=水水


# ------------------------------------------------------------------------------
# 4. JX3API 接口与鉴权配置（https://www.jx3api.com）
# ------------------------------------------------------------------------------
# JX3API HTTP 数据接口地址（默认官方地址，一般无需修改）
JX3API_BASE_URL=https://www.jx3api.com

# JX3API WebSocket 实时事件推送地址（默认官方地址）
# 若未来不想开启事件推送服务，可将其设置为空字符串 JX3_WSS_URL="" 即可完全停用
JX3_WSS_URL=wss://socket.nicemoe.cn

# 站点访问令牌（Token）
# 前期免费使用可留空；将来若购买了 JX3API 会员 Token，填写在此处即可自动启用 VIP 高级接口并解除频率限制
# JX3API_TOKEN=

# 推栏 Ticket（名剑大会 JJC 战绩、推栏配装/阵眼等高级数据特权查询必需）
# JX3_TUILAN_TICKET=

# WebSocket 实时推送专属 Token（单服75/月，全服200/月）
# 若购买了官方事件版 WSS 推送服务请填写在此处；留空则仅接收系统免费推送事件
# JX3WSS_TOKEN=
